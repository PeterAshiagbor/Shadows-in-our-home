---
import { config } from '../config.js';
import { story, shots, cover } from '../content/story.js';
import Shot from '../components/Shot.astro';
import '../styles/global.css';

const shot = (id) => shots.find((s) => s.id === id);

const siteUrl = Astro.site?.href ?? 'https://shadows-in-our-home.vercel.app/';
const ogImage = new URL('/assets/og-cover.jpg', siteUrl).href;

const author = { '@type': 'Person', name: config.author };

// Book + WebSite structured data. Truthful only — no ISBN, offers, dates, or
// ratings until they genuinely exist (§7). Add them here when the book is live.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Shadows in Our Home',
    author,
    inLanguage: 'en',
    bookFormat: 'https://schema.org/EBook',
    genre: ['Contemporary fiction', 'Domestic drama', 'African literature'],
    description: config.description,
    image: ogImage,
    url: siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Shadows in Our Home',
    url: siteUrl,
    inLanguage: 'en',
    author,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.title}</title>
    <meta name="description" content={config.description} />
    <meta name="author" content={config.author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#171310" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:site_name" content="Shadows in Our Home" />
    <meta property="og:title" content="Shadows in Our Home" />
    <meta property="og:description" content={config.description} />
    <meta property="og:type" content="book" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shadows in Our Home — book cover" />
    <meta property="book:author" content={config.author} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Shadows in Our Home" />
    <meta name="twitter:description" content={config.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Shadows in Our Home — book cover" />

    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <script>document.body.classList.add('js');</script>

    <div class="progress" id="progress" aria-hidden="true"></div>

    <!-- 0 · Title -->
    <section class="section section--full hero" data-act="1" id="s0">
      <div class="hero__media" data-parallax>
        <Shot shot={shot(1)} eager />
      </div>
      <div class="hero__content">
        <h1 class="hero__title">Shadows in Our&nbsp;Home</h1>
        <p class="hero__byline">{story.title.byline} {config.author}</p>
        <button type="button" class="hero__play" id="autoplay-btn">▶&nbsp;&nbsp;Watch the story — 3 min</button>
      </div>
      <p class="hero__cue">{story.title.scrollCue}</p>
    </section>

    <!-- 1 · Hook line (two beats) -->
    <section class="section section--full hero hook" data-act="1" id="s1">
      <div class="hero__media hook__media">
        <Shot shot={shot(2)} attrs={{ 'data-sharpen': true }} />
      </div>
      <div class="hook__lines">
        <p class="hook__line will-reveal">{story.hook.line}</p>
        <p class="hook__line hook__line--beat will-reveal">{story.hook.beat}</p>
      </div>
    </section>

    <!-- 2 · Ch 1 scene A — Zarek watching; Kwame's teasing -->
    <section class="section" data-act="1" id="s2">
      <div class="prose panel">
        <p class="kicker">{story.ch1a.kicker}</p>
        <h2 class="chapter-heading">{story.ch1a.heading}</h2>
        {story.ch1a.blocks.map((b) => <p class="will-reveal">{b.text}</p>)}
        <div class="dialogue">
          {story.ch1a.dialogue.map((d) => <p class="will-reveal">{d.line}</p>)}
        </div>
        {story.ch1a.close.map((b) => <p class="will-reveal">{b.text}</p>)}
      </div>
      <figure class="figure">
        <Shot shot={shot(3)} />
      </figure>
    </section>

    <!-- 3 · Ch 1 scene B — the exchange (pinned, four beats, given space) -->
    <section class="hero exchange" data-act="1" id="s3" data-pin>
      <div class="hero__media exchange__media">
        <Shot shot={shot(4)} />
      </div>
      <div class="exchange__lines">
        {story.ch1b.beats.map((b, i) => (
          <p class="will-reveal" data-beat={i + 1}>{b}</p>
        ))}
      </div>
    </section>

    <!-- 4 · Ch 1 close -->
    <section class="section" data-act="1" id="s4">
      <div class="prose panel">
        {story.ch1c.blocks.map((b) => <p class="will-reveal">{b.text}</p>)}
        <div class="dialogue">
          {story.ch1c.dialogue.map((d) => <p class="will-reveal">{d.line}</p>)}
        </div>
        {story.ch1c.night.map((b) => <p class="will-reveal">{b.text}</p>)}
      </div>
    </section>

    <!-- W1 · Whisper — the light flickers for the first time -->
    <section class="whisper" data-act="1" id="w1" aria-label="A note from the story's future">
      <div class="whisper__text">
        {story.whisper1.lines.map((l) => <p>{l}</p>)}
      </div>
    </section>

    <!-- 5 · Act break — Love Blossoms -->
    <section class="section section--full hero" data-act="2" id="s5">
      <div class="hero__media" data-parallax>
        <Shot shot={shot(5)} />
      </div>
      <div class="act-break__card will-reveal">
        <p class="act-break__number">{story.actTwo.number}</p>
        <h2 class="act-break__title">{story.actTwo.title}</h2>
      </div>
    </section>

    <!-- 6 · Ch 2 — theirs; walks; Kwame; the asking -->
    <section class="section" data-act="2" id="s6">
      <div class="prose panel">
        {story.ch2.blocks.map((b) => <p class="will-reveal">{b.text}</p>)}
        {story.ch2.dialogue.length > 0 && (
          <div class="dialogue">
            {story.ch2.dialogue.map((d) => <p class="will-reveal">{d.line}</p>)}
          </div>
        )}
      </div>
      <div class="montage" data-montage>
        <div class="montage__track">
          <figure><Shot shot={shot(5)} /></figure>
          <figure><Shot shot={shot(6)} /></figure>
          <figure><Shot shot={shot(2)} /></figure>
        </div>
      </div>
      <div class="prose panel">
        {story.ch2.asking.map((b) => <p class="will-reveal">{b.text}</p>)}
      </div>
    </section>

    <!-- 7 · Pull quote -->
    <section class="section pull-quote" data-act="2" id="s7">
      <blockquote class="will-reveal">
        {story.pullQuote.text}
        <footer>{story.pullQuote.attribution}</footer>
      </blockquote>
    </section>

    <!-- W2 · Whisper — the book's thesis; the title moment -->
    <section class="whisper whisper--deep" data-act="2" id="w2" aria-label="A note from the story's future">
      <div class="whisper__text">
        {story.whisper2.lines.map((l, i) => (
          i === story.whisper2.emphasisIndex
            ? <p class="whisper__emphasis">{l}</p>
            : <p>{l}</p>
        ))}
      </div>
    </section>

    <!-- 8 · Ch 3 scene A — proposal + wedding + the vows -->
    <section class="section" data-act="3" id="s8">
      <div class="prose panel">
        <p class="kicker">{story.ch3a.kicker}</p>
        <h2 class="chapter-heading">{story.ch3a.heading}</h2>
        {story.ch3a.blocks.map((b) => <p class="will-reveal">{b.text}</p>)}
        {story.ch3a.dialogue.length > 0 && (
          <div class="dialogue">
            {story.ch3a.dialogue.map((d) => <p class="will-reveal">{d.line}</p>)}
          </div>
        )}
      </div>
      <figure class="figure crossfade" data-crossfade>
        <Shot shot={shot(7)} />
        <Shot shot={shot(8)} />
      </figure>
      <div class="vows" data-vows>
        <p class="vows__line will-reveal">{story.ch3a.vows.line}</p>
        <div class="vows__shadow">
          {story.ch3a.vows.shadow.map((l) => <p>{l}</p>)}
        </div>
      </div>
    </section>

    <!-- 9 · Ch 3 scene B — Victoria arrives; daylight drops -->
    <section class="section" data-act="3" id="s9">
      <div class="prose panel">
        {story.ch3b.blocks.map((b) => (
          <p class:list={['will-reveal', { 'quiet-beat': b.quiet }]}>{b.text}</p>
        ))}
      </div>
      <figure class="figure crossfade" data-crossfade>
        <Shot shot={shot(9)} />
        <Shot shot={shot(10)} />
      </figure>
    </section>

    <!-- 10 · The fracture (pinned; each beat dims the scene) -->
    <section class="hero section--full fracture" data-act="4" id="s10" data-pin>
      <div class="hero__media fracture__media">
        <Shot shot={shot(11)} />
      </div>
      <div class="fracture__dim" aria-hidden="true"></div>
      <div class="fracture__content">
        {story.fracture.intro.map((t, i) => (
          <p class="fracture__intro will-reveal" data-beat={i === 0 ? undefined : i}>{t}</p>
        ))}
        <div class="dialogue">
          {story.fracture.dialogue.map((d, i) => (
            <p class="will-reveal" data-beat={i + 3}>{d.line}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 · The last line (shot 12 barely visible in the dark behind it) -->
    <section class="last-line" data-act="4" id="s11">
      <div class="last-line__media" aria-hidden="true">
        <Shot shot={shot(12)} />
      </div>
      <div>
        <p class="last-line__lead will-reveal">{story.lastLine.lead}</p>
        <p class="last-line__final will-reveal"><strong>{story.lastLine.final}</strong></p>
      </div>
      <p class="last-line__bridge" data-bridge>{story.lastLine.bridge.text}</p>
    </section>

    <!-- 11b · Keziah's File — one entry open, the rest sealed -->
    <section class="section file" data-act="4" id="s11b">
      <div class="file__inner">
        <p class="kicker">{story.file.kicker}</p>
        <h2 class="chapter-heading file__heading will-reveal">{story.file.heading}</h2>
        <div class="file__card will-reveal">
          <div class="file__meta">
            <span>{story.file.entry.label}</span>
            <span>{story.file.entry.chapter}</span>
          </div>
          <blockquote>“{story.file.entry.quote}”</blockquote>
        </div>
        <ul class="file__sealed" aria-label="Sealed entries — revealed in the full book">
          {story.file.sealed.map((num) => (
            <li class="file__row" data-sealed tabindex="0" role="button" aria-label={`Entry ${num} — sealed. The book opens it.`}>
              <span class="file__num">Entry {num}</span>
              <span class="remaining__smudge"></span>
              <span class="file__lock" aria-hidden="true">✕</span>
            </li>
          ))}
        </ul>
        <p class="file__caption" id="file-caption" role="status" aria-live="polite" data-text={story.file.sealedCaption}></p>
        <p class="file__note will-reveal">{story.file.note}</p>
      </div>
    </section>

    <!-- 12 · Conversion -->
    <section class="cta" data-act="4" id="s12">
      <div class="cta__inner">
        <picture>
          <source srcset={cover.webp} type="image/webp" />
          <img class="cta__cover will-reveal" src={cover.jpg} alt={cover.alt} loading="lazy" decoding="async" width="640" height="959" />
        </picture>
        <p class="cta__eyebrow">{story.conversion.eyebrow}</p>
        <h2 class="cta__headline">{story.conversion.headline}</h2>
        <p class="cta__subhead">{story.conversion.subhead}</p>

        <ol class="remaining" aria-label="The chapters inside the book">
          <li class="remaining__label">{story.conversion.remaining.label}</li>
          {story.conversion.remaining.visible.map((c, i) => (
            <li class={`remaining__item ${c.read ? 'remaining__item--read' : `remaining__item--fade${Math.max(0, i - 3)}`}`}>
              <span class="remaining__num">{c.num}</span> {c.title}
            </li>
          ))}
          {story.conversion.remaining.hidden.map((num) => (
            <li class="remaining__item remaining__item--hidden" aria-hidden="true">
              <span class="remaining__num">{num}</span> <span class="remaining__smudge"></span>
            </li>
          ))}
          <li class="sr-only">{story.conversion.remaining.hiddenNote}</li>
        </ol>

        {config.prelaunch ? (
          <a class="cta__button" id="buy-cta" href="#capture" data-event="cta_click_prelaunch">
            {story.conversion.prelaunchCtaLabel}
          </a>
        ) : (
          <>
            <a class="cta__button" id="buy-cta" href={config.universalBookLink} data-event="cta_click_buy">
              {story.conversion.ctaLabel}{config.price ? ` — ${config.price}` : ''}
            </a>
            <nav class="cta__retailers" aria-label="Buy from a specific store">
              {config.retailers.map((r) => (
                <a href={r.href} data-event="cta_click_buy">{r.name}</a>
              ))}
            </nav>
          </>
        )}
        <p class="cta__risk">{story.conversion.riskReducer}</p>

        {config.testimonials.length > 0 && (
          <div class="testimonials">
            {config.testimonials.map((t) => (
              <blockquote>
                {t.quote}
                <cite>{t.name}</cite>
              </blockquote>
            ))}
          </div>
        )}

        <div class="capture" id="capture">
          <h3>{config.prelaunch ? story.conversion.prelaunchEmailHeading : story.conversion.emailHeading}</h3>
          <form class="capture-form" method="post" action={config.emailEndpoint || '#'} data-source="chapter4-form">
            <label class="sr-only" for="capture-email">Email address</label>
            <input id="capture-email" type="email" name="email" required placeholder="your@email.com" autocomplete="email" />
            <button type="submit">{story.conversion.emailButton}</button>
          </form>
          <p class="capture__msg" role="status"></p>
        </div>
      </div>
    </section>

    <!-- 13 · Footer -->
    <footer class="footer" data-act="4">
      <p class="footer__bio">
        <!-- OPEN ITEM §9.1: author bio -->
        {config.author} writes contemporary African fiction. <em>Shadows in Our Home</em> is
        their debut novel.
      </p>
      {config.socials.length > 0 && (
        <nav class="footer__links" aria-label="Social links">
          {config.socials.map((s) => <a href={s.href}>{s.name}</a>)}
        </nav>
      )}
      <p class="footer__imprint">© 2026 {config.author}. All rights reserved.</p>
    </footer>

    <!-- Persistent UI -->
    <a class="sticky-cta" id="sticky-cta" href="#s12" data-event="cta_click_sticky">Get the book</a>
    <button type="button" class="autoplay-ctl" id="autoplay-ctl" hidden>❚❚&nbsp;&nbsp;Pause</button>

    <div class="exit-intent" id="exit-intent" role="dialog" aria-label="Free chapter offer" aria-hidden="true">
      <button type="button" id="exit-close" aria-label="Close">×</button>
      <p>Before you go — <a href="#capture">get Chapter 4 free by email</a>. No spoilers, no spam.</p>
    </div>

    <!-- Release modal — opens from the primary CTA while in prelaunch -->
    <dialog class="release-modal" id="release-modal" aria-labelledby="release-modal-title">
      <button type="button" class="release-modal__close" id="release-close" aria-label="Close">×</button>
      <p class="cta__eyebrow">{story.conversion.eyebrow}</p>
      <h3 class="release-modal__title" id="release-modal-title">{story.conversion.modal.title}</h3>
      <p class="release-modal__body">{story.conversion.modal.body}</p>
      <form class="capture-form release-modal__form" method="post" action={config.emailEndpoint || '#'} data-source="release-modal">
        <label class="sr-only" for="modal-email">Email address</label>
        <input id="modal-email" type="email" name="email" required placeholder="your@email.com" autocomplete="email" />
        <button type="submit">{story.conversion.emailButton}</button>
      </form>
      <p class="capture__msg" role="status" data-success={story.conversion.modal.success}></p>
    </dialog>

    <script src="../scripts/main.js"></script>
  </body>
</html>
